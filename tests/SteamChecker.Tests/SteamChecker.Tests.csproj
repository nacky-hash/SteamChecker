<Project Sdk="Microsoft.NET.Sdk">

  <!--
    通常の開発環境（NuGet が使える）ではこちらを使う:
      dotnet test tests/SteamChecker.Tests

    NuGet に到達できない環境では tests/SteamChecker.TestRunner を使う。
    テストの .cs ファイルは共通なので二重管理は発生しない。
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- TestRunner 側のシムは取り込まない（本物の xUnit と衝突するため） -->
    <Compile Remove="..\SteamChecker.TestRunner\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SteamChecker.Core\SteamChecker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

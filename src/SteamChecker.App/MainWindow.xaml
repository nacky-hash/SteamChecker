<Window x:Class="SteamChecker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SteamChecker — Steam ライブラリの容量アドバイザー"
        Width="980" Height="700"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="12">

        <!-- ヘッダー -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="ScanButton"
                    DockPanel.Dock="Left"
                    Padding="16,6"
                    Click="OnScanClick"
                    Content="スキャン開始" />
            <TextBlock x:Name="StatusText"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Text="このツールはスキャンでファイルを一切変更しません。" />
        </DockPanel>

        <!-- フッター（合計） -->
        <Border DockPanel.Dock="Bottom" Padding="4,8,4,0">
            <StackPanel>
                <TextBlock x:Name="SummaryText" FontWeight="Bold" />
                <TextBlock x:Name="FootnoteText"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Text="圧縮見込みは実測サンプリングに基づく推定値です。数ポイント程度ぶれることがあります。このアプリはファイルを変更しません。" />
            </StackPanel>
        </Border>

        <!-- 結果一覧 -->
        <ListView x:Name="ResultList">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="Bold"
                                       FontSize="14"
                                       Margin="0,10,0,4"
                                       Text="{Binding Name}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="タイトル" Width="280" DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="概要" Width="360" DisplayMemberBinding="{Binding Summary}" />
                    <GridViewColumn Header="根拠" Width="280" DisplayMemberBinding="{Binding Reasons}" />
                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>
</Window>

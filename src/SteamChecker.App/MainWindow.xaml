<Window x:Class="SteamChecker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SteamChecker — Steam ライブラリの容量アドバイザー"
        Width="1080" Height="740"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="12">

        <!-- ヘッダー -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="ScanButton"
                    DockPanel.Dock="Left"
                    Padding="16,6"
                    Click="OnScanClick"
                    ToolTip="各ゲームのファイルを読んで圧縮率を実測します。ライブラリの規模により数分かかります。ファイルは変更しません。"
                    Content="圧縮見込みを解析（数分）" />
            <Button x:Name="StopButton"
                    DockPanel.Dock="Right"
                    Padding="14,6" Margin="8,0,0,0"
                    Visibility="Collapsed"
                    Click="OnStopClick"
                    Content="中止" />
            <TextBlock x:Name="StatusText"
                       Margin="12,0,12,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="このツールはスキャンでファイルを一切変更しません。" />
        </DockPanel>

        <!-- 進捗ゲージ（処理中だけ現れる） -->
        <Grid x:Name="ProgressArea"
              DockPanel.Dock="Top"
              Margin="0,0,0,10"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 見出し: 何をしているか / 残り時間 -->
            <DockPanel Grid.Row="0" Margin="2,0,2,4">
                <TextBlock x:Name="ProgressEta"
                           DockPanel.Dock="Right"
                           Foreground="Gray"
                           Text="" />
                <TextBlock x:Name="ProgressCaption"
                           TextTrimming="CharacterEllipsis"
                           Text="" />
            </DockPanel>

            <Grid Grid.Row="1">
                <ProgressBar x:Name="ProgressGauge"
                             Style="{StaticResource GaugeStyle}"
                             Minimum="0" Maximum="1" Value="0" />
                <TextBlock x:Name="ProgressPercent"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="0%" />
            </Grid>
        </Grid>

        <!-- 操作バー -->
        <Border DockPanel.Dock="Bottom" Padding="4,8,4,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="CompressButton"
                            DockPanel.Dock="Right"
                            Padding="14,4" Margin="8,0,0,0"
                            IsEnabled="False"
                            Click="OnCompressClick"
                            Content="圧縮..." />
                    <Button x:Name="RestoreButton"
                            DockPanel.Dock="Right"
                            Padding="14,4" Margin="8,0,0,0"
                            IsEnabled="False"
                            Click="OnRestoreClick"
                            Content="元に戻す..." />
                    <TextBlock x:Name="SelectionText"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="タイトルを選択すると操作できます（Ctrl / Shift クリックで複数選択）" />
                </DockPanel>
                <TextBlock x:Name="SummaryText" FontWeight="Bold" />
                <TextBlock x:Name="FootnoteText"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Text="圧縮見込みは実測サンプリングに基づく推定値です。数ポイント程度ぶれることがあります。圧縮は「元に戻す」でいつでも解除でき、ゲーム更新の書き込みでも自動的に解除されます。実行前に Steam の起動状態やファイルシステムを確認します。" />
            </StackPanel>
        </Border>

        <!-- 結果一覧（複数選択可 / 列ヘッダーでグループ内ソート） -->
        <ListView x:Name="ResultList"
                  SelectionMode="Extended"
                  SelectionChanged="OnSelectionChanged"
                  GridViewColumnHeader.Click="OnHeaderClick">
            <!--
                この起動中に圧縮・復元した行に印を付ける。
                選択が外れても「何を実行したか」が画面に残るようにするため。
            -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TouchedThisSession}" Value="True">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Background" Value="#E8F4FD" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <!--
                                Run.Text は既定が TwoWay バインドで、読み取り専用の
                                CollectionViewGroup.Name に書き戻そうとして例外になる。
                                Mode=OneWay を必ず明示すること（2026-07-31 に実際に踏んだ）。

                                色は分類の探しやすさのための補助。意味は文字が担う。
                            -->
                            <Border Margin="0,12,0,4"
                                    Padding="10,6"
                                    CornerRadius="4"
                                    Background="{Binding Name, Converter={StaticResource GroupColor}, Mode=OneWay}"
                                    BorderBrush="{Binding Name, Converter={StaticResource GroupAccent}, Mode=OneWay}"
                                    BorderThickness="5,0,0,0">
                                <TextBlock FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="{Binding Name, Converter={StaticResource GroupAccent}, Mode=OneWay}">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="{Binding ItemCount, StringFormat=（{0} 件）, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="280" DisplayMemberBinding="{Binding Title}">
                        <GridViewColumnHeader Content="タイトル" Tag="Title" />
                    </GridViewColumn>
                    <GridViewColumn Width="110" DisplayMemberBinding="{Binding SizeText}">
                        <GridViewColumnHeader Content="サイズ" Tag="SizeBytes" />
                    </GridViewColumn>
                    <GridViewColumn Width="120" DisplayMemberBinding="{Binding SavingText}">
                        <GridViewColumnHeader Content="圧縮見込み" Tag="SavedBytes" />
                    </GridViewColumn>
                    <GridViewColumn Width="100" DisplayMemberBinding="{Binding PlayedText}">
                        <GridViewColumnHeader Content="最終プレイ" Tag="DaysSincePlayedSort" />
                    </GridViewColumn>
                    <GridViewColumn Width="380" DisplayMemberBinding="{Binding Reasons}">
                        <GridViewColumnHeader Content="根拠" Tag="Reasons" />
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>
</Window>

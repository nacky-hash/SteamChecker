<Window x:Class="SteamChecker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SteamChecker — Steam ライブラリの容量アドバイザー"
        Width="1020" Height="720"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="12">

        <!-- ヘッダー -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="ScanButton"
                    DockPanel.Dock="Left"
                    Padding="16,6"
                    Click="OnScanClick"
                    Content="スキャン開始" />
            <CheckBox x:Name="ExperimentalCheck"
                      DockPanel.Dock="Right"
                      VerticalAlignment="Center"
                      Checked="OnExperimentalChanged"
                      Unchecked="OnExperimentalChanged"
                      ToolTip="圧縮・復元はファイルへの書き込みを伴います。実行前に事前検査と確認ダイアログを必ず通します。"
                      Content="圧縮機能を有効にする（実験的）" />
            <TextBlock x:Name="StatusText"
                       Margin="12,0,12,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="このツールはスキャンでファイルを一切変更しません。" />
        </DockPanel>

        <!-- 操作バー（選択タイトルに対する圧縮/復元） -->
        <Border DockPanel.Dock="Bottom" Padding="4,8,4,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="CompressButton"
                            DockPanel.Dock="Right"
                            Padding="14,4" Margin="8,0,0,0"
                            IsEnabled="False"
                            Click="OnCompressClick"
                            Content="圧縮..." />
                    <Button x:Name="RestoreButton"
                            DockPanel.Dock="Right"
                            Padding="14,4" Margin="8,0,0,0"
                            IsEnabled="False"
                            Click="OnRestoreClick"
                            Content="元に戻す..." />
                    <Button x:Name="CancelButton"
                            DockPanel.Dock="Right"
                            Padding="14,4" Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Click="OnCancelClick"
                            Content="中断" />
                    <TextBlock x:Name="SelectionText"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="タイトルを選択すると操作できます（圧縮機能が有効な場合）" />
                </DockPanel>
                <TextBlock x:Name="SummaryText" FontWeight="Bold" />
                <TextBlock x:Name="FootnoteText"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Text="圧縮見込みは実測サンプリングに基づく推定値です。数ポイント程度ぶれることがあります。圧縮はゲーム更新の書き込みで自動的に解除されます。" />
            </StackPanel>
        </Border>

        <!-- 結果一覧 -->
        <ListView x:Name="ResultList" SelectionChanged="OnSelectionChanged" SelectionMode="Single">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="Bold"
                                       FontSize="14"
                                       Margin="0,10,0,4"
                                       Text="{Binding Name}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="タイトル" Width="280" DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="概要" Width="360" DisplayMemberBinding="{Binding Summary}" />
                    <GridViewColumn Header="根拠" Width="300" DisplayMemberBinding="{Binding Reasons}" />
                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>
</Window>
